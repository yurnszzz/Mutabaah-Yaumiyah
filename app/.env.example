# Google Apps Script Web App URL
# Setelah deploy GAS sebagai Web App, paste URL-nya di sini
# Contoh: https://script.google.com/macros/s/AKfycbx.../exec
VITE_GAS_URL=

# Google OAuth Client ID (untuk tombol "Sign in with Google")
# Buat di: https://console.cloud.google.com/apis/credentials
# Pilih "OAuth client ID" > "Web application"
# Tambahkan Authorized JavaScript Origins: http://localhost:5173 (dev) dan domain production
VITE_GOOGLE_CLIENT_ID=
